##Load climate data and run PCA
library(spatstat)
library(terra)
library(foreach)
source("Funciones-spatstat/imFromStack.R")
clim <- rast(list.files("Datos-centroide/", "tif", full.names = T))
plot(clim)
## Load spp data and format
calcal <-  read.csv("Datos-centroide/cal_cal_test.csv")
calmel <- read.csv("Datos-centroide/cal_mel_test.csv")
spp <- list(calcal, calmel)
source("~/Documentos/Cosas ENES/Materias/Posgrado/Curso-modelado-nichos/Tutorial-centroides.R")
clim.spp[[1]]
clim.spp[[1]] |> plot()
clim.spp[[2]] |> plot()
bio.im.list <- lapply(clim.spp, imFromStack)
##Working windows
win <- list(as.owin(bio.im.list[[1]][[1]]),
as.owin(bio.im.list[[2]][[1]]))
## transforming species points to a planar point pattern
spp.ppp <- lapply(1:2, function(x){
ppp(spp[[x]][, 'Longitud'], spp[[x]][, 'Latitud'], window = win[[x]], check = F)
})
cal.cal.formula <- "~ bio8 + bio11 + bio12 + I(bio8^2) + I(bio11^2) + I(bio12^2)"
cal.mel.formula <- "~ bio5 + bio7 + bio16 + I(bio5^2) + I(bio7^2) + I(bio16^2)"
## Ajuste de modelo
cal.cal.ppm <- ppm(spp.ppp[[1]],
trend = formula(cal.cal.formula),
covariates = bio.im.list[[1]])
cal.mel.ppm <- ppm(spp.ppp[[2]],
trend = formula(cal.mel.formula),
covariates = bio.im.list[[2]])
summary(cal.cal.ppm)
summary(cal.mel.ppm)
diagnose.ppm(cal.cal.ppm)
diagnose.ppm(cal.cal.ppm)
diagnose.ppm(cal.cal.ppm)
par(mar= c(2,2,2,2))
diagnose.ppm(cal.cal.ppm)
k.cal <- envelope(cal.cal.ppm, fun = Kest, nsim = 39)
k.cal |> plot()
k.cal <- envelope(cal.cal.ppm, fun = Kest, nsim = 99)
k.cal |> plot()
diagnose.ppm(cal.mel.ppm)
k.mel <- envelope(cal.mel.ppm, fun = Kest, nsim = 99)
k.mel |> plot()
dim(clim.spp[[1]])
dim(clim.spp[[2]])
cal.cal.pred <- predict(cal.cal.ppm, type = "trend", dimyx = c(166, 158))
cal.mel.pred <- predict(cal.mel.ppm, type = "trend", dimyx = c(208, 195))
class(cal.cal.pred)
plot(cal.cal.pred)
cal.cal.pred.r <- rast(cal.cal.pred)
cal.mel.pred.r <- rast(cal.mel.pred)
plot(cal.cal.pred.r)
plot(cal.mel.pred.r)
########################
####Fitting ellipses####
########################
spp.vars <- list(c(8, 11, 12), c(5, 7, 16))
clim.spp.points <- lapply(clim.spp, function(x){as.data.frame(x, xy = T)})
i = 1
data <- data.frame(extract(clim.spp[[i]], spp[[i]][, c("Longitud", "Latitud")]))[, paste0("bio", spp.vars[[i]])]
data
data <- na.omit(data)
cent <- colMeans(data)
cov <- cov(data)
cov
apply(data, 2, var)
dist <- mahalanobis(clim.spp.points[[i]][, names(data)], center = cent, cov = cov)
dist
dist.r <- rast(data.frame(clim.spp.points[[i]][, c("x", "y")], dist))
plot(dist.r)
plot(dist.r)
suit <- exp(-0.5 * dist.r)
plot(suit)
ellips <- foreach(i = seq_along(spp)) %do% {
data <- data.frame(extract(clim.spp[[i]], spp[[i]][, c("Longitud", "Latitud")]))[, paste0("bio", spp.vars[[i]])]
data <- na.omit(data)
cent <- colMeans(data)
cov <- cov(data)
dist <- mahalanobis(clim.spp.points[[i]][, names(data)], center = cent, cov = cov)
dist.r <- rast(data.frame(clim.spp.points[[i]][, c("x", "y")], dist))
suit <- exp(-0.5 * dist.r)
return(list(cen.cov = cent,
Suitability = suit,
Distance = dist.r))
}
names(ellips) <- c("Cal.cal", "Cal.mel")
coef
coef.calcal <- coef(cal.cal.ppm)
coef.calmel <- coef(cal.mel.ppm)
coef.calcal
coef.calmel <- coef(cal.mel.ppm)
cent.calcal <- c()
cent.calmel <- c()
cent.calcal
for(i in 1:3){
cent.calcal[i] <- -coef.calcal[i+1]/(2*coef.calcal[i + 4])
cent.calmel[i] <- -coef.calmel[i+1]/(2*coef.calmel[i + 4])
}
cent.calcal
ellips$Cal.cal$cen.cov
cent.calmel
ellips$Cal.mel$cen.cov
par(mfrow  = c(1, 2))
plot(cal.cal.pred.r, main = "PPM")
plot(ellips$Cal.cal$Suitability, main = "Elipsoide")
par(mfrow  = c(1, 2), mar = c(1,1,1,1))
plot(cal.cal.pred.r, main = "PPM")
plot(ellips$Cal.cal$Suitability, main = "Elipsoide")
par(mfrow  = c(1, 2), mar = c(1,1,1,1))
plot(cal.cal.pred.r, main = "PPM")
plot(ellips$Cal.cal$Suitability, main = "Elipsoide")
plot(cal.mel.pred.r, main = "PPM")
plot(ellips$Cal.mel$Suitability, main = "Elipsoide")
pairs(c(cal.cal.pred.r, ellips$Cal.cal$Suitability))
pairs(c(cal.mel.pred.r, ellips$Cal.mel$Suitability))
global(clim.spp[[1]], range)
global(clim.spp[[1]], range, na.rm = T)
ellips$Cal.cal$cen.cov
plot(clim.spp[[2]])
global(clim.spp[[2]], range, na.rm = T)
ellips$Cal.cal$cen.cov
global(clim.spp[[1]], range, na.rm = T)
ellips$Cal.cal$cen.cov
plot(clim.spp[[1]])
